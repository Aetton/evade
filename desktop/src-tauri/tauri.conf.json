{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EvaDE",
  "version": "0.1.0",
  "identifier": "dev.evade.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"title": "EvaDE · Eva Desktop Edition", "width": 1440, "height": 900, "minWidth": 780, "minHeight": 560}
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' asset: http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {"active": false, "icon": ["icons/icon.png"]}
}
